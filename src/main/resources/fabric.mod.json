  "name": "Fofo Raças",
  "description": "Sistema de raças com vantagens e desvantagens, estilo Origins. Funciona só no servidor; para /mods e /texturas o jogador precisa ter o mod no cliente.",
  "authors": [],
  "license": "All-Rights-Reserved",
  "environment": "*",
  "entrypoints": {
    "main": ["com.fofo.racas.RacasMod"],
    "client": ["com.fofo.racas.client.RacasClient"]
  },
  "mixins": ["fofo_racas.mixins.json"],
  "depends": {
    "fabricloader": ">=0.18.1",
    "minecraft": "~1.21.11",
    "java": ">=21",
    "fabric-api": "*"
  }
}
